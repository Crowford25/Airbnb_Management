# Public values are exposed to the browser. Never put secrets here.
NEXT_PUBLIC_APP_NAME=Aureum Stays
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Future authentication service origin. Leave empty when Next.js owns the API.
NEXT_PUBLIC_API_BASE_URL=

# PostgreSQL. The application and DBeaver should point to the same database.
# Percent-encode special characters in the URL username or password.
DATABASE_URL=postgresql://evolyst_dev:replace-with-a-strong-password@localhost:5432/evolyst_dev
# Local PostgreSQL: disable. Hosted PostgreSQL: use require or verify-full.
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
HOLD_SWEEP_INTERVAL_MS=30000
HOLD_SWEEP_BATCH_SIZE=100

# Stripe test keys for local development. Use live keys only in production.
# The webhook secret comes from Stripe Workbench or `stripe listen`.
STRIPE_SECRET_KEY=sk_test_replace
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# Email notifications. Console is a local preview provider only; use Resend in
# production after verifying the sender domain.
EMAIL_PROVIDER=console
EMAIL_FROM=Aureum Stays <bookings@example.com>
RESEND_API_KEY=re_replace
RESEND_WEBHOOK_SECRET=whsec_replace
# Optional comma-separated override. If empty, active Team Leads, Managers and
# Super Admins receive reservation alerts.
ADMIN_ALERT_EMAILS=
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_LOCK_TIMEOUT_MS=900000

# Server-only authentication values. Generate a random secret with at least 32
# characters. Escape each dollar sign in scrypt hashes because Next.js expands
# unescaped environment references.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_SECONDS=28800
AUTH_CUSTOMER_EMAIL=customer@example.com
AUTH_CUSTOMER_NAME=Customer
AUTH_CUSTOMER_PASSWORD_HASH=scrypt\$replace-salt\$replace-hash
AUTH_EMPLOYEE_EMAIL=employee@example.com
AUTH_EMPLOYEE_NAME=Employee
AUTH_EMPLOYEE_PASSWORD_HASH=scrypt\$replace-salt\$replace-hash
AUTH_LEAD_EMAIL=lead@example.com
AUTH_LEAD_NAME=Team Lead
AUTH_LEAD_PASSWORD_HASH=scrypt\$replace-salt\$replace-hash
AUTH_MANAGER_EMAIL=manager@example.com
AUTH_MANAGER_NAME=Manager
AUTH_MANAGER_PASSWORD_HASH=scrypt\$replace-salt\$replace-hash
AUTH_SUPER_ADMIN_EMAIL=admin@example.com
AUTH_SUPER_ADMIN_NAME=Super Administrator
AUTH_SUPER_ADMIN_PASSWORD_HASH=scrypt\$replace-salt\$replace-hash
