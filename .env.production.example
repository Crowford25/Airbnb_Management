# Production values are examples only. Store real secrets in the hosting
# platform's encrypted environment settings, never in this file.
NEXT_PUBLIC_APP_NAME=Aureum Stays
NEXT_PUBLIC_APP_URL=https://replace-with-production-domain.example
NEXT_PUBLIC_API_BASE_URL=

DATABASE_URL=postgresql://evolyst_prod:replace-with-a-strong-random-password@replace-with-production-host:5432/evolyst_prod
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
HOLD_SWEEP_INTERVAL_MS=30000
HOLD_SWEEP_BATCH_SIZE=100
# Optional local/manual logical backup directory. Managed database backups remain primary.
DATABASE_BACKUP_DIRECTORY=backups

STRIPE_SECRET_KEY=sk_live_replace
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

EMAIL_PROVIDER=resend
EMAIL_FROM=Aureum Stays <bookings@replace-with-production-domain.example>
RESEND_API_KEY=re_replace
RESEND_WEBHOOK_SECRET=whsec_replace
ADMIN_ALERT_EMAILS=
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_LOCK_TIMEOUT_MS=900000

AUTH_SESSION_SECRET=replace-with-a-different-long-random-production-secret
AUTH_SESSION_TTL_SECONDS=28800
